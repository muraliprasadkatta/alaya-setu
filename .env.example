# Ee file ni `.env` gaa copy chesi, mee machine/server ki correct
# values pettandi. `.env` ni git ki EPPUDU commit cheyakandi.

# Local dev lo True. Production lo idi set cheyakapothe (leda False
# pettina) - safe default: DEBUG = False.
DJANGO_DEBUG=True

# Comma-separated, spaces lekunda. Production lo mee real domain/IP.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.29.249

# Production lo REQUIRED - Django ye kotha random secret key generate
# cheskondi (ఉదా. `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`)
# DJANGO_SECRET_KEY=your-production-secret-key-here